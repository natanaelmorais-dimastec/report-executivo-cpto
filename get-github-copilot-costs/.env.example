# GitHub credentials for the Enhanced Billing Platform API.
#
# Generate a Personal Access Token (PAT):
#   github.com -> Settings -> Developer settings -> Personal access tokens
#
# Classic PAT:    scope `manage_billing:copilot` (read-only billing)
# Fine-grained:   Resource owner = your org; Permissions -> Organization "Plan" -> Read
#
# Copy to .env (already gitignored).

GITHUB_TOKEN=

# Optional: default org slug so you don't have to pass --org every time.
GITHUB_ORG=
