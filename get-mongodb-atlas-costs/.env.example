# MongoDB Atlas API credentials.
# Generate at: Atlas -> Organization Access Manager -> API Keys -> Create.
# Minimum role: "Organization Billing Viewer" (least privilege for billing reads).
# Restrict by IP if possible.
#
# Copy to .env (already gitignored) and fill in.

MONGODB_ATLAS_PUBLIC_KEY=
MONGODB_ATLAS_PRIVATE_KEY=

# Optional: default Org ID if you don't want to pass --org-id every time.
# Find it in Atlas -> Organization Settings -> Organization ID.
MONGODB_ATLAS_ORG_ID=
